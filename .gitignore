# dependencies
node_modules/
.pnpm-store/

# build output
# 必须锚定到包根：未锚定的 `lib/` 会同时匹配 packages/*/src/lib/，
# 而 bean-validator 与 config-loader 的源码正是放在 src/lib/ 下面。
/lib/
/dist/
packages/*/lib/
packages/*/dist/
*.tsbuildinfo

# stale compiled artifacts next to sources
packages/*/src/**/*.js
packages/*/src/**/*.d.ts
packages/*/src/**/*.map

# test output
coverage/

# editors
.idea/
.vscode/
*.iml

# os
.DS_Store

# logs
*.log
pnpm-debug.log*
npm-debug.log*

# local
.env
.env.local
