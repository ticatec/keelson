{
  "compilerOptions": {
    "module": "commonjs",
    "esModuleInterop": true,
    "target": "es2022",
    "moduleResolution": "node",
    "strict": true,
    "declaration": true,
    "outDir": "./lib/cjs",
    "rootDir": "src",
    "baseUrl": "."
  },
  "lib": ["es2022"],
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "src/__tests__/**/*"
  ]
}
