{
  "name": "@ticatec/logger-pino",
  "version": "1.0.0",
  "description": "The pino adapter for @ticatec/logger-api. Routes a framework's log records into pino, with console/file appenders, per-category levels and child logger context binding.",
  "type": "module",
  "main": "./lib/cjs/index.js",
  "module": "./lib/esm/index.js",
  "types": "./lib/esm/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./lib/esm/index.d.ts",
        "default": "./lib/esm/index.js"
      },
      "require": {
        "types": "./lib/cjs/index.d.ts",
        "default": "./lib/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*",
    "README.md",
    "README_CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build:cjs": "tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('./lib/cjs/package.json', '{\\\"type\\\": \\\"commonjs\\\"}')\"",
    "build:esm": "tsc -p tsconfig.esm.json && node -e \"require('fs').writeFileSync('./lib/esm/package.json', '{\\\"type\\\": \\\"module\\\"}')\"",
    "build": "node -e \"require('fs').rmSync('./lib', { recursive: true, force: true })\" && pnpm build:cjs && pnpm build:esm",
    "clean": "node -e \"require('fs').rmSync('./lib', { recursive: true, force: true })\"",
    "prepublishOnly": "pnpm build",
    "publish-public": "pnpm publish --access public --no-git-checks",
    "test": "jest",
    "lint": "eslint 'src/**/*.ts'",
    "typecheck": "tsc -p tsconfig.cjs.json --noEmit && tsc -p tsconfig.esm.json --noEmit"
  },
  "keywords": [
    "pino",
    "logger",
    "logging",
    "logger-api",
    "adapter",
    "provider",
    "appender",
    "context-logger",
    "structured-logging",
    "typescript",
    "nodejs",
    "keelson",
    "ticatec",
    "esm",
    "commonjs",
    "dual-module"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ticatec/keelson.git",
    "directory": "packages/logger-pino"
  },
  "author": {
    "name": "Henry Feng",
    "email": "huili.f@gmail.com",
    "url": "https://github.com/ticatec"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ticatec/keelson/issues"
  },
  "homepage": "https://github.com/ticatec/keelson/tree/main/packages/logger-pino",
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@ticatec/logger-api": "workspace:*",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.8.6",
    "jest": "^29.7.0",
    "pino": "^9.0.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "@ticatec/logger-api": ">=1.0.0",
    "pino": ">=9.0.0"
  }
}