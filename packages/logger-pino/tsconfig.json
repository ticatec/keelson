{
  "compilerOptions": {
    "target": "es2017",
    "lib": ["es2017"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "skipLibCheck": true,
    "sourceRoot": "src",
    "types": ["node", "jest"]
  },
  "references": [
    { "path": "./tsconfig.cjs.json" },
    { "path": "./tsconfig.esm.json" }
  ],
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "src/__tests__/**/*",
    "**/__tests__/**"
  ]
}