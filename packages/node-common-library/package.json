{
  "name": "@ticatec/node-common-library",
  "version": "4.0.0",
  "description": "A comprehensive Node.js database access framework providing robust abstractions for database connection management, SQL execution, transaction handling, pagination, and dynamic query building.",
  "type": "module",
  "main": "./lib/cjs/index.js",
  "module": "./lib/esm/index.js",
  "types": "./lib/cjs/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./lib/esm/index.d.ts",
        "default": "./lib/esm/index.js"
      },
      "require": {
        "types": "./lib/cjs/index.d.ts",
        "default": "./lib/cjs/index.js"
      }
    },
    "./lib/db/Field": {
      "types": "./lib/cjs/db/Field.d.ts",
      "import": "./lib/esm/db/Field.js",
      "require": "./lib/cjs/db/Field.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*",
    "assets/**/*",
    "README.md",
    "README_CN.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('lib',{recursive:true,force:true})\"",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "copy:pkg": "node -e \"const fs=require('fs');fs.copyFileSync('assets/cjs-package.json','lib/cjs/package.json');fs.copyFileSync('assets/esm-package.json','lib/esm/package.json')\"",
    "build": "pnpm clean && pnpm build:cjs && pnpm build:esm && pnpm copy:pkg",
    "prebuild": "pnpm lint",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build",
    "publish-public": "pnpm publish --access public --no-git-checks",
    "test": "jest",
    "lint": "eslint 'src/**/*.ts'",
    "typecheck": "tsc -p tsconfig.cjs.json --noEmit && tsc -p tsconfig.esm.json --noEmit"
  },
  "keywords": [
    "nodejs",
    "database",
    "orm",
    "dao",
    "sql",
    "transaction",
    "pagination",
    "search",
    "criteria",
    "mysql",
    "postgresql",
    "sqlite",
    "connection-pool",
    "bean-factory",
    "dependency-injection",
    "typescript",
    "framework",
    "ticatec",
    "esm",
    "commonjs",
    "dual-module"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ticatec/keelson.git",
    "directory": "packages/node-common-library"
  },
  "author": {
    "name": "Henry Feng",
    "email": "huili.f@gmail.com",
    "url": "https://github.com/ticatec"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ticatec/keelson/issues"
  },
  "homepage": "https://github.com/ticatec/keelson/tree/main/packages/node-common-library",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=6.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@ticatec/logger-api": ">=1.0.0"
  },
  "dependencies": {
    "reflect-metadata": "^0.2.2",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@ticatec/logger-api": "workspace:*",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.8.6",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "pino": "^9.5.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.0.0"
  }
}