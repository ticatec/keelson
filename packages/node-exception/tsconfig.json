{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "sourceRoot": "src",
    "types": ["node", "jest"]
  },
  "include": [
    "src/**/*"
  ],
  "exclude": ["src/__tests__/**/*", "**/__tests__/**"]
}
