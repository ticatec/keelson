{
  "name": "@ticatec/node-exception",
  "version": "2.1.0",
  "description": "Production-ready Express error handling middleware with standardized HTTP error types, centralized exception management, and automatic content negotiation for REST APIs. Type-safe, with logging injected through the @ticatec/logger-api contract.",
  "type": "module",
  "main": "lib/cjs/index.js",
  "types": "lib/cjs/index.d.ts",
  "module": "lib/esm/index.js",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./lib/esm/index.d.ts",
        "default": "./lib/esm/index.js"
      },
      "require": {
        "types": "./lib/cjs/index.d.ts",
        "default": "./lib/cjs/index.js"
      }
    },
    "./utils": {
      "import": {
        "types": "./lib/esm/utils.d.ts",
        "default": "./lib/esm/utils.js"
      },
      "require": {
        "types": "./lib/cjs/utils.d.ts",
        "default": "./lib/cjs/utils.js"
      }
    },
    "./ErrorResponse": {
      "import": {
        "types": "./lib/esm/ErrorResponse.d.ts",
        "default": "./lib/esm/ErrorResponse.js"
      },
      "require": {
        "types": "./lib/cjs/ErrorResponse.d.ts",
        "default": "./lib/cjs/ErrorResponse.js"
      }
    },
    "./HttpError": {
      "import": {
        "types": "./lib/esm/HttpError.d.ts",
        "default": "./lib/esm/HttpError.js"
      },
      "require": {
        "types": "./lib/cjs/HttpError.d.ts",
        "default": "./lib/cjs/HttpError.js"
      }
    },
    "./HttpContainer": {
      "import": {
        "types": "./lib/esm/HttpContainer.d.ts",
        "default": "./lib/esm/HttpContainer.js"
      },
      "require": {
        "types": "./lib/cjs/HttpContainer.d.ts",
        "default": "./lib/cjs/HttpContainer.js"
      }
    },
    "./handleError": {
      "import": {
        "types": "./lib/esm/handleError.d.ts",
        "default": "./lib/esm/handleError.js"
      },
      "require": {
        "types": "./lib/cjs/handleError.d.ts",
        "default": "./lib/cjs/handleError.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*",
    "assets/**/*",
    "README.md",
    "README_CN.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('lib',{recursive:true,force:true})\"",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build": "pnpm clean && pnpm build:cjs && pnpm build:esm && pnpm copy:pkg",
    "copy:pkg": "node -e \"const fs=require('fs');fs.copyFileSync('assets/cjs-package.json','lib/cjs/package.json');fs.copyFileSync('assets/esm-package.json','lib/esm/package.json')\"",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build",
    "publish:public": "pnpm publish --access public --no-git-checks",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major",
    "test": "jest",
    "prebuild": "pnpm lint",
    "lint": "eslint 'src/**/*.ts'",
    "typecheck": "tsc -p tsconfig.cjs.json --noEmit && tsc -p tsconfig.esm.json --noEmit"
  },
  "keywords": [
    "express",
    "express-middleware",
    "error-handler",
    "error-handling",
    "exception",
    "exception-handler",
    "http-error",
    "http-errors",
    "rest-api",
    "api",
    "typescript",
    "nodejs",
    "middleware",
    "error-middleware",
    "error-response",
    "http-status",
    "status-codes",
    "400",
    "401",
    "403",
    "404",
    "500",
    "authentication",
    "authorization",
    "validation",
    "content-negotiation",
    "type-safe",
    "production-ready",
    "enterprise",
    "esm",
    "commonjs",
    "dual-module",
    "ticatec",
    "logging"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ticatec/keelson.git",
    "directory": "packages/node-exception"
  },
  "author": {
    "name": "Henry Feng",
    "email": "huili.f@gmail.com",
    "url": "https://github.com/ticatec"
  },
  "contributors": [
    {
      "name": "Henry Feng",
      "email": "huili.f@gmail.com",
      "url": "https://github.com/ticatec"
    }
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ticatec/keelson/issues"
  },
  "homepage": "https://github.com/ticatec/keelson/tree/main/packages/node-exception",
  "funding": {
    "type": "individual",
    "url": "https://github.com/sponsors/henryfeng"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@ticatec/logger-api": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.8.6",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "express": "^5.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.0"
  },
  "peerDependencies": {
    "@ticatec/logger-api": ">=1.0.0"
  }
}
