{
  "compilerOptions": {
    "esModuleInterop": true,
    "target": "es2022",
    "lib": ["es2022"],
    "moduleResolution": "node",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "jest"]
  },
  "include": [
    "src/**/*"
  ]
}
